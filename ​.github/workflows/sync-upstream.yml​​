name: Sync Upstream
on:
  schedule:
    - cron: "0 3 * * *"
  workflow_dispatch:

jobs:
  sync-ts:
    timeout-minutes: 30
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          ref: ts
          fetch-depth: 0  # 获取完整提交历史

      - name: Verify Upstream Branch
        run: |
          git remote add upstream https://github.com/JavaLionLi/plus-ui.git
          git fetch upstream
          if ! git ls-remote --heads upstream | grep -q "refs/heads/ts"; then
            echo "::error::ts branch not found in upstream repository!"
            exit 1
          fi

      - name: Merge Upstream
        run: |
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          if ! git merge upstream/ts --allow-unrelated-histories; then
            echo "::error::Merge conflict detected in ts branch"
            echo "::notice::Resolve conflicts locally and push manually"
            exit 1
          fi
          
      - name: Push Changes
        run: |
          git push https://${{ secrets.ACCESS_TOKEN }}@github.com/${{ github.repository }}.git ts
